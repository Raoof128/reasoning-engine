{
  "tools": [
    {
      "name": "init_research_session",
      "description": "Create a new research session. Estimates difficulty and returns budget allocation.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "init_research_sessionArguments",
        "type": "object"
      }
    },
    {
      "name": "register_branch",
      "description": "Register a new reasoning branch generated by an Actor agent.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "trace": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "string"
              }
            ],
            "title": "Trace"
          },
          "sources": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "string"
              }
            ],
            "default": "[]",
            "title": "Sources"
          },
          "parent_id": {
            "default": "",
            "title": "Parent Id",
            "type": "string"
          },
          "depth": {
            "default": 0,
            "title": "Depth",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "trace"
        ],
        "title": "register_branchArguments",
        "type": "object"
      }
    },
    {
      "name": "score_branch",
      "description": "Record a Critic's dual-signal score for a reasoning branch.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "branch_id": {
            "title": "Branch Id",
            "type": "string"
          },
          "q_score": {
            "title": "Q Score",
            "type": "number"
          },
          "advantage": {
            "title": "Advantage",
            "type": "number"
          },
          "critique": {
            "title": "Critique",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          }
        },
        "required": [
          "session_id",
          "branch_id",
          "q_score",
          "advantage",
          "critique",
          "confidence"
        ],
        "title": "score_branchArguments",
        "type": "object"
      }
    },
    {
      "name": "select_next_branches",
      "description": "Run DORA allocation: compute kappa, decide explore vs exploit, return branch decisions.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "select_next_branchesArguments",
        "type": "object"
      }
    },
    {
      "name": "record_reflection_tool",
      "description": "Store a Reflexion cycle's critique and revision in episodic memory.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "branch_id": {
            "title": "Branch Id",
            "type": "string"
          },
          "original_critique": {
            "title": "Original Critique",
            "type": "string"
          },
          "revision_summary": {
            "title": "Revision Summary",
            "type": "string"
          },
          "score_before": {
            "title": "Score Before",
            "type": "number"
          },
          "score_after": {
            "title": "Score After",
            "type": "number"
          }
        },
        "required": [
          "session_id",
          "branch_id",
          "original_critique",
          "revision_summary",
          "score_before",
          "score_after"
        ],
        "title": "record_reflection_toolArguments",
        "type": "object"
      }
    },
    {
      "name": "check_termination",
      "description": "Check whether the research session should terminate.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "check_terminationArguments",
        "type": "object"
      }
    },
    {
      "name": "get_session_state",
      "description": "Return full session state including all branches and scores.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "get_session_stateArguments",
        "type": "object"
      }
    },
    {
      "name": "consensus_candidates",
      "description": "Return top-K branches by q_score for final synthesis.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "top_k": {
            "default": 3,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "consensus_candidatesArguments",
        "type": "object"
      }
    },
    {
      "name": "save_to_memory",
      "description": "Persist episodic memory from a research session for future recall.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "key_learnings": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "string"
              }
            ],
            "title": "Key Learnings"
          },
          "domain_tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "string"
              }
            ],
            "title": "Domain Tags"
          }
        },
        "required": [
          "session_id",
          "query",
          "key_learnings",
          "domain_tags"
        ],
        "title": "save_to_memoryArguments",
        "type": "object"
      }
    },
    {
      "name": "recall_memory_tool",
      "description": "Retrieve relevant episodic memories from past research sessions.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 5,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "recall_memory_toolArguments",
        "type": "object"
      }
    },
    {
      "name": "sanitize_content",
      "description": "Sanitize web-crawled content, stripping HTML, scripts, and prompt injection patterns.",
      "inputSchema": {
        "properties": {
          "raw_text": {
            "title": "Raw Text",
            "type": "string"
          }
        },
        "required": [
          "raw_text"
        ],
        "title": "sanitize_contentArguments",
        "type": "object"
      }
    },
    {
      "name": "plan_research_angles_tool",
      "description": "Return prioritized research angles and starter questions for a query.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "max_angles": {
            "default": 6,
            "title": "Max Angles",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "plan_research_angles_toolArguments",
        "type": "object"
      }
    },
    {
      "name": "evidence_gap_questions_tool",
      "description": "Generate verification questions for claims before final synthesis.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "claims": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "string"
              }
            ],
            "title": "Claims"
          }
        },
        "required": [
          "query",
          "claims"
        ],
        "title": "evidence_gap_questions_toolArguments",
        "type": "object"
      }
    },
    {
      "name": "start_research_run",
      "description": "Create a verifiable research run with selected mode and profile.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "mode": {
            "default": "standard",
            "title": "Mode",
            "type": "string"
          },
          "profile": {
            "default": "auto",
            "title": "Profile",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "start_research_runArguments",
        "type": "object"
      }
    },
    {
      "name": "classify_research_mode_tool",
      "description": "Classify the research mode, escalating high-stakes queries.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "requested_mode": {
            "default": "standard",
            "title": "Requested Mode",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "classify_research_mode_toolArguments",
        "type": "object"
      }
    },
    {
      "name": "scholar_search_tool",
      "description": "Search Scholar Gateway through the verifiable research service.",
      "inputSchema": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "query"
        ],
        "title": "scholar_search_toolArguments",
        "type": "object"
      }
    },
    {
      "name": "get_scholar_auth_status",
      "description": "Return Scholar Gateway auth status without exposing token values.",
      "inputSchema": {
        "properties": {
          "dummy": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dummy"
          }
        },
        "title": "get_scholar_auth_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "run_research_pipeline_tool",
      "description": "Run the MVP verifiable research pipeline and export an attested run pack.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "draft": {
            "title": "Draft",
            "type": "string"
          },
          "mode": {
            "default": "standard",
            "title": "Mode",
            "type": "string"
          },
          "profile": {
            "default": "auto",
            "title": "Profile",
            "type": "string"
          }
        },
        "required": [
          "query",
          "draft"
        ],
        "title": "run_research_pipeline_toolArguments",
        "type": "object"
      }
    },
    {
      "name": "run_quality_gate_tool",
      "description": "Run the quality gate for persisted claims and verifications.",
      "inputSchema": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "run_quality_gate_toolArguments",
        "type": "object"
      }
    },
    {
      "name": "export_run_pack_tool",
      "description": "Run the pipeline and return the exported run-pack path.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "draft": {
            "title": "Draft",
            "type": "string"
          },
          "mode": {
            "default": "standard",
            "title": "Mode",
            "type": "string"
          },
          "profile": {
            "default": "auto",
            "title": "Profile",
            "type": "string"
          }
        },
        "required": [
          "query",
          "draft"
        ],
        "title": "export_run_pack_toolArguments",
        "type": "object"
      }
    }
  ],
  "has_tools_capability": true
}
